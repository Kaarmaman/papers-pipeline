# Copy to .env for a local run, or enter the values in the Portainer stack environment UI.

# Retrieval
PAPER_SEARCH_SOURCES=crossref,openalex,semantic,arxiv,ssrn,zenodo,hal
MAX_RESULTS_PER_SOURCE=8
SEARCH_TIMEOUT_SECONDS=180
LOOKBACK_DAYS=30
CHECK_INTERVAL_HOURS=168
RUN_ON_STARTUP=true
FETCH_FULLTEXT=true
MAX_FULLTEXT_CHARS=28000
KEEP_FULLTEXT=false
PAPER_PORT=8099

# Required MongoDB storage. Use a hostname/IP reachable from the worker container.
MONGO_URI=
MONGO_DATABASE=interesting_papers
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Run diagnostics expire after this many days; paper metadata is retained until explicitly pruned.
MONGO_RUN_RETENTION_DAYS=365

# Optional upstream connector settings. Keep secrets in Portainer, never in Git.
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL=
PAPER_SEARCH_MCP_DOAJ_API_KEY=
PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN=
PAPER_SEARCH_MCP_IEEE_API_KEY=
PAPER_SEARCH_MCP_ACM_API_KEY=

# Optional OpenAI-compatible analysis provider. Without this, the report remains useful
# but marks the five write-ups as metadata-only instead of inventing claims.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=120
